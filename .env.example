# Environment Variables
# Copy this to .env and fill in your values

# ============================================================================
# MongoDB Configuration (MongoDB Atlas)
# ============================================================================
# Get your connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB=climate_indices
MONGO_ASSETS_COLLECTION=assets

# ============================================================================
# Google Cloud Storage
# ============================================================================
GCS_BUCKET=climate-tiles-cluster
GCS_PREFIX=uploads

# GCS Credentials Path
# - Local development: Use relative path
# - Docker: Path is auto-adjusted to /app/data/gcs_credentials.json by container
GOOGLE_APPLICATION_CREDENTIALS=./data/gcs_credentials.json

# ============================================================================
# Application Settings
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Demo Frontend Configuration
# ============================================================================
# API base URL for demo frontend (include full path to climate-indices API)
# If not set, defaults to http://localhost:8080/api/climate-indices
DEMO_API_BASE=http://your-server:8080/api/climate-indices

# Cesium Ion access token for 3D globe visualisation
# Get your token from https://cesium.com/ion/tokens
CESIUM_ION_TOKEN=your-cesium-ion-token-here

# ============================================================================
# Service tokens (optional — leave unset to run open)
# ============================================================================
# Signed Ed25519 tokens for service-to-service calls. Entirely optional: leave
# all four unset and the API stays open and /demo stays mounted, which is the
# standalone mode. Set all four and every climate endpoint requires an
# `x-service-token` header, and /demo is not mounted — a browser cannot hold a
# signing key, so the page could only 401.
#
# Setting only some of them is a startup error, not a silent fall back to open.
#
# Generate a set with the keygen tool in the Express repo: npm run keys:gen
#
# SERVICE_NAME is this service's identity — the `aud` callers must address, and
# the name its entry carries in SERVICE_TOKEN_PUBLIC_KEYS. It has to match the
# audience the Express service mints tokens for, so changing it here alone
# rejects every token Express sends.
#
# SERVICE_NAME=e2-visengine-service
# SERVICE_TOKEN_KID=e2-visengine-service-2026-09
# SERVICE_TOKEN_PRIVATE_KEY=<base64 PKCS8 DER — this service only, never share>
# SERVICE_TOKEN_PUBLIC_KEYS={"<kid>":{"service":"...","key":"<base64 SPKI DER>"}}

# ============================================================================
# Source offer (AGPL section 13)
# ============================================================================
# This service is AGPL licensed, so users interacting with it over a network are
# entitled to the source of the version answering their requests. Point SOURCE_URL
# at wherever you publish the source of what you actually deployed. There is no
# default: unset starts the service but leaves /source with nothing to offer, which
# is section 13 unmet.
# SOURCE_REVISION is normally baked in at image build time, not set here.
SOURCE_URL=
# SOURCE_REVISION=

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Create data/gcs_credentials.json (see docs/setup-gcs-credentials.md)
# 2. Update MONGO_URI with your MongoDB Atlas connection string
# 3. Update GCS_BUCKET with your Google Cloud Storage bucket name
# 4. For local development: uv run uvicorn app.main:app --reload
# 5. For Docker deployment: docker-compose up -d
